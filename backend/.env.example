# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/bulkmailer

# Server port
PORT=5000

# development | production — enables stricter checks (CORS lockdown, JWT_SECRET length) when set to production
NODE_ENV=development

# Exact origin of the deployed frontend, e.g. https://mail.yourdomain.com
# Only enforced when NODE_ENV=production
FRONTEND_ORIGIN=http://localhost:3000

# JSON Web Token secret (used for admin login)
JWT_SECRET=change_this_to_a_long_random_string

# Gmail (or any SMTP) credentials used to send emails
# For Gmail, create an "App Password" — regular password will not work.
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_char_app_password

# Hardcoded admin login (simple auth, no user DB table needed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
